rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default-deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // Users collection
    match /users/{userId} {
      allow get: if isOwner(userId);
      allow list: if false; // Deny user enumeration
      allow create: if isOwner(userId) &&
        request.resource.data.uid == userId &&
        request.resource.data.email is string &&
        request.resource.data.email.size() <= 256;
      allow update: if isOwner(userId) &&
        request.resource.data.uid == userId;
      allow delete: if isOwner(userId);

      // User persistent logs subcollection
      match /logs/{logId} {
        allow get: if isOwner(userId);
        allow list: if isOwner(userId);
        allow create: if isOwner(userId) &&
          request.resource.data.userId == userId &&
          request.resource.data.action is string &&
          request.resource.data.action.size() <= 256;
        allow update: if false; // Logs are immutable audit trails
        allow delete: if isOwner(userId);
      }

      // User saved locations subcollection
      match /locations/{locationId} {
        allow get, list: if isOwner(userId);
        allow create: if isOwner(userId) &&
          request.resource.data.userId == userId;
        allow update: if isOwner(userId) &&
          request.resource.data.userId == userId;
        allow delete: if isOwner(userId);
      }

      // User AI artifacts subcollection
      match /ai_artifacts/{artifactId} {
        allow get, list: if isOwner(userId);
        allow create: if isOwner(userId) &&
          request.resource.data.userId == userId &&
          request.resource.data.prompt is string &&
          request.resource.data.prompt.size() <= 2048;
        allow update: if isOwner(userId);
        allow delete: if isOwner(userId);
      }
    }
  }
}
